make distclean

CFLAGS="-Os -ffunction-sections -fdata-sections" \
LDFLAGS="-Wl,--gc-sections" \
./configure \
  --prefix="$PWD/build/linux" \
  --enable-small \
  --enable-pic \
  --disable-shared \
  --enable-static \
  --disable-everything \
  --disable-doc \
  --disable-debug \
  --disable-network \
  --disable-autodetect \
  --disable-avdevice \
  --enable-swresample \
  --enable-swscale \
  --disable-bsfs \
  --disable-hwaccels \
  --disable-parsers \
  --enable-zlib \
  --enable-avutil \
  --enable-avcodec \
  --enable-avformat \
  --enable-avfilter \
  --enable-filter=format \
  --enable-filter=scale \
  --enable-protocol=file \
  --enable-parser=h264 \
  --enable-parser=mpegaudio \
  --enable-demuxer=mov \
  --enable-demuxer=matroska \
  --enable-demuxer=ogg \
  --enable-demuxer=mp3 \
  --enable-demuxer=flac \
  --enable-demuxer=wav \
  --enable-muxer=mov \
  --enable-muxer=matroska \
  --enable-muxer=image2 \
  --enable-decoder=h264 \
  --enable-decoder=aac \
  --enable-encoder=mjpeg\
  --enable-encoder=png


make -j$(nproc)
make install